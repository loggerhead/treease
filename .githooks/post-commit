#!/bin/sh
set -eu

if [ "${TREEASE_CHANGELOG_AMENDING:-}" = "1" ]; then
  exit 0
fi

commit_subject=$(git log -1 --format=%s)
case "$commit_subject" in
  docs:*|docs\(*|ci:*|ci\(*|test:*|test\(*|chore:*|chore\(*|refactor:*|refactor\(*|build:*|build\(*|feat\(ci\)*|fix\(ci\)*|perf\(ci\)*)
    exit 0
    ;;
  feat\(*|fix\(*|perf\(*|feat:*|fix:*|perf:*|revert\(*|revert:*)
    ;;
  *)
    exit 0
    ;;
esac

generated_files='apps/web/src/lib/content/changelog.generated.ts
apps/web/src/lib/content/changelog.generated.meta.json
apps/web/static/changelog.xml'

if git status --porcelain -- $generated_files | grep -q .; then
  echo 'post-commit: changelog outputs are already modified; skipping automatic generation' >&2
  exit 0
fi

if command -v node >/dev/null 2>&1; then
  node_bin=$(command -v node)
elif [ -x /opt/homebrew/bin/node ]; then
  node_bin=/opt/homebrew/bin/node
elif [ -x /usr/local/bin/node ]; then
  node_bin=/usr/local/bin/node
else
  echo 'post-commit: Node.js is unavailable; the original commit was kept' >&2
  exit 0
fi

if ! "$node_bin" apps/web/scripts/generate-changelog.mjs; then
  echo 'post-commit: changelog generation failed; the original commit was kept' >&2
  exit 0
fi

if git diff --quiet -- $generated_files; then
  exit 0
fi

git add -- $generated_files
TREEASE_CHANGELOG_AMENDING=1 git commit --amend --no-edit >/dev/null

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "treease-web",
  "main": "./src/cloudflare-worker.ts",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "treease.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  }
}

{
  "name": "treease-web",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  },
  "scripts": {
    "assets:r2:sync": "node ./scripts/sync-r2-assets.mjs",
    "assets:r2:check": "node ./scripts/check-r2-assets.mjs",
    "assets:tinify:png": "node ./scripts/tinify-pngs.mjs",
    "content:changelog": "node ./scripts/generate-changelog.mjs",
    "sitemap:generate": "node ./scripts/generate-sitemap.mjs",
    "dev": "node ./scripts/wasm-dev.mjs",
    "dev:vite": "WASM_VERSION=$(node ./scripts/wasm-version.mjs) vp dev",
    "dev:desktop:vite": "TREEASE_WORKSPACE_SURFACE=desktop WASM_VERSION=$(node ./scripts/wasm-version.mjs) vp dev --host 127.0.0.1 --port 1420",
    "dev:desktop": "pnpm wasm:sync && pnpm dev:desktop:vite",
    "dev:wasm": "pnpm wasm:sync && pnpm dev:vite",
    "build": "pnpm sitemap:generate && pnpm wasm:bindgen:check && pnpm wasm:sync && WASM_VERSION=$(node ./scripts/wasm-version.mjs) node ./scripts/with-build-lock.mjs vp build",
    "build:e2e": "pnpm sitemap:generate && pnpm wasm:bindgen:check && pnpm wasm:sync && TREEASE_E2E=true WASM_VERSION=$(node ./scripts/wasm-version.mjs) node ./scripts/with-build-lock.mjs vp build --mode test",
    "build:desktop": "node ./scripts/build-desktop.mjs",
    "analyze:bundle": "pnpm wasm:bindgen:check && pnpm wasm:sync && TREEASE_BUNDLE_ANALYZE=1 WASM_VERSION=$(node ./scripts/wasm-version.mjs) node ./scripts/with-build-lock.mjs vp build",
    "preview": "vp preview",
    "seo:verify": "node ./scripts/verify-seo.mjs",
    "deploy:workers": "pnpm build && pnpm assets:r2:sync && pnpm exec wrangler deploy",
    "check:circular": "pnpm exec madge --circular --extensions ts --ts-config ./tsconfig.json src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "wasm:build": "cd ../../packages/core && cargo build --locked --target wasm32-unknown-unknown --release --lib",
    "wasm:language-support": "cd ../../packages/core && cargo run --locked --bin export_language_support",
    "wasm:copy": "node ./scripts/wasm-dev.mjs --copy-only",
    "wasm:sync": "pnpm wasm:language-support && pnpm wasm:build && pnpm wasm:copy",
    "wasm:bindgen": "node ./scripts/wasm-bindgen.mjs",
    "wasm:bindgen:check": "node ./scripts/wasm-bindgen-check.mjs",
    "bench:graph-stream": "node ./scripts/graph-stream-benchmark.mjs",
    "test": "pnpm test:unit && pnpm test:e2e:core",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:e2e:fixtures",
    "test:unit": "vp test $(find src -name '*.test.ts' -print)",
    "test:integration": "vp test $(find test/integration -name '*.test.ts' -print)",
    "test:wasm": "pnpm wasm:bindgen && vp test",
    "test:coverage": "vp test --coverage",
    "test:e2e": "pnpm build:e2e && playwright test test/e2e",
    "test:e2e:headed": "pnpm test:e2e --headed",
    "test:e2e:fixtures": "playwright test --config playwright.config.fixtures.ts",
    "test:e2e:fixtures:headed": "pnpm test:e2e:fixtures --headed",
    "test:e2e:core": "pnpm build:e2e && pnpm test:e2e:core:run",
    "test:e2e:core:run": "playwright test --config playwright.config.core.ts",
    "test:e2e:core:headed": "pnpm build:e2e && pnpm test:e2e:core:run --headed",
    "test:e2e:a11y:runtime": "playwright test --config playwright.config.runtime.ts",
    "test:e2e:cloudflare": "pnpm build && playwright test --config playwright.config.cloudflare.ts",
    "verify:e2e-preview": "node ./scripts/verify-e2e-preview.mjs",
    "serve:e2e": "vp preview --outDir \"$PWD/build\" --host 127.0.0.1 --port 4173 --strictPort",
    "wasm:setup:rust": "rustup target add wasm32-unknown-unknown"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@internationalized/date": "^3.10.0",
    "@lucide/svelte": "^0.561.0",
    "@playwright/test": "^1.53.1",
    "@sveltejs/adapter-auto": "7.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.9",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/tauri-plugin": "1.0.0",
    "better-icons": "^1.0.3",
    "bits-ui": "^2.14.4",
    "csstype": "^3.2.3",
    "globals": "^16.0.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.1",
    "madge": "^8.0.0",
    "shadcn-svelte": "1.1.0",
    "svelte": "5.56.1",
    "svelte-check": "4.3.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plus": "^0.2.4",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@leafer-in/editor": "^2.0.1",
    "@leafer-in/export": "^2.0.1",
    "@leafer-in/state": "^2.0.1",
    "@leafer-in/text-editor": "^2.0.1",
    "@leafer-in/view": "^2.0.1",
    "@leafer-in/viewport": "^2.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "@treease/api-contracts": "workspace:*",
    "@tanstack/svelte-virtual": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@treease/share-protocol": "workspace:*",
    "fuzzysort": "^3.1.0",
    "zod": "^4.1.11",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "leafer-ui": "^2.0.0",
    "lodash-es": "^4.17.21",
    "lucide-svelte": "^0.471.0",
    "monaco-editor": "^0.55.1",
    "svelte-sonner": "^0.3.0",
    "svelte-splitpanes": "^8.0.12"
  }
}

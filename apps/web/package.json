{
	"name": "treease-web",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"assets:r2:upload": "node ./scripts/upload-r2-assets.mjs",
		"assets:r2:check": "node ./scripts/check-r2-assets.mjs",
		"cli-assets:check": "node ./scripts/check-cli-assets.mjs",
		"assets:tinify:png": "node ./scripts/tinify-pngs.mjs",
		"dev": "node ./scripts/wasm-dev.mjs",
		"dev:vite": "WASM_VERSION=$(node ./scripts/wasm-version.mjs) vp dev",
		"dev:wasm": "pnpm wasm:sync && pnpm dev:vite",
		"build": "pnpm wasm:bindgen:check && pnpm wasm:sync && WASM_VERSION=$(node ./scripts/wasm-version.mjs) vp build && node ./scripts/cli-assets.mjs",
		"analyze:bundle": "pnpm wasm:bindgen:check && pnpm wasm:sync && TREEASE_BUNDLE_ANALYZE=1 WASM_VERSION=$(node ./scripts/wasm-version.mjs) vp build && node ./scripts/cli-assets.mjs",
		"preview": "vp preview",
		"deploy:pages": "pnpm build && pnpm assets:r2:check && npx wrangler pages deploy build && pnpm cli-assets:check",
		"check:circular": "npx madge --circular --extensions ts ./",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint",
		"fmt": "vp fmt",
		"wasm:build": "cd ../../packages/core && cargo build --locked --target wasm32-unknown-unknown --release --lib",
		"wasm:build:full": "pnpm wasm:build",
		"wasm:language-support": "cd ../../packages/core && cargo run --locked --bin export_language_support",
		"wasm:copy": "node ./scripts/wasm-dev.mjs --copy-only",
		"wasm:sync": "pnpm wasm:language-support && pnpm wasm:build && pnpm wasm:copy",
		"wasm:bindgen": "node ./scripts/wasm-bindgen.mjs",
		"wasm:bindgen:check": "node ./scripts/wasm-bindgen-check.mjs",
		"bench:graph-stream": "node ./scripts/graph-stream-benchmark.mjs",
		"test": "pnpm test:unit && pnpm test:e2e:core",
		"test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:e2e:fixtures",
		"test:unit": "vp test $(find src -name '*.test.ts' -print)",
		"test:integration": "vp test $(find test/integration -name '*.test.ts' -print)",
		"test:wasm": "pnpm wasm:bindgen && vp test",
		"test:coverage": "vp test --coverage",
		"test:e2e": "playwright test test/e2e",
		"test:e2e:headed": "pnpm test:e2e --headed",
		"test:e2e:fixtures": "playwright test --config playwright.config.fixtures.ts",
		"test:e2e:fixtures:headed": "pnpm test:e2e:fixtures --headed",
		"test:e2e:core": "pnpm wasm:bindgen && playwright test --config playwright.config.core.ts",
		"test:e2e:core:headed": "pnpm test:e2e:core --headed",
		"wasm:setup:rust": "rustup target add wasm32-unknown-unknown"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.53.1",
		"@sveltejs/adapter-auto": "7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.1.18",
		"@types/node": "24.10.9",
		"@vitest/coverage-istanbul": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"better-icons": "^1.0.3",
		"bits-ui": "^2.14.4",
		"csstype": "^3.2.3",
		"globals": "^16.0.0",
		"happy-dom": "^20.8.4",
		"jsdom": "^29.0.1",
		"madge": "^8.0.0",
		"shadcn-svelte": "1.1.0",
		"svelte": "5.56.1",
		"svelte-check": "4.3.5",
		"tailwindcss": "4.1.18",
		"typescript": "5.9.3",
		"vite": "^8.0.0",
		"vite-bundle-analyzer": "^1.3.8",
		"vite-plus": "^0.2.4",
		"vitest": "4.1.0"
	},
	"dependencies": {
		"@leafer-in/editor": "^2.0.1",
		"@leafer-in/export": "^2.0.1",
		"@leafer-in/state": "^2.0.1",
		"@leafer-in/text-editor": "^2.0.1",
		"@leafer-in/view": "^2.0.1",
		"@leafer-in/viewport": "^2.0.0",
		"@supabase/supabase-js": "^2.57.4",
		"@tanstack/svelte-virtual": "^3.0.0",
		"fuzzysort": "^3.1.0",
		"idb": "^8.0.3",
		"leafer-ui": "^2.0.0",
		"lodash-es": "^4.17.21",
		"lucide-svelte": "^0.471.0",
		"monaco-editor": "^0.55.1",
		"svelte-sonner": "^0.3.0",
		"svelte-splitpanes": "^8.0.12"
	}
}

PUBLIC_ASSET_BASE_URL=https://assets.treease.com
TREEASE_R2_ASSET_BUCKET=treease-assets

# Supabase public browser credentials for OAuth and email OTP login.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Optional GA4 measurement. Leave unset to disable analytics locally.
GA_MEASUREMENT_ID=
# Set to 1 when a consent UI/CMP controls analytics consent.
GA_CONSENT_REQUIRED=0

# Fixed prices shown on the landing-page pricing cards. The prewarm request still runs for checkout preparation.
PUBLIC_PRICING_MONTHLY_PRICE=4.98
PUBLIC_PRICING_YEARLY_PRICE=3.98

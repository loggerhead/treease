# Public domain for deployed static assets; get it from the Cloudflare R2 custom or public access domain.
PUBLIC_ASSET_BASE_URL=https://assets.treease.com
# Cloudflare R2 bucket name; get it from the R2 dashboard after creating the bucket, for asset sync and storage.
TREEASE_R2_ASSET_BUCKET=treease-assets

# Wrangler uses the authenticated Cloudflare profile for `pnpm assets:r2:sync`; no value is required here.
# Optional: generate this in the TinyPNG/Tinify API settings, for local PNG compression.
TINIFY_API_KEY=

# Public server API origin; set it to the deployed API URL for auth, billing, sharing, and AI requests.
PUBLIC_API_ORIGIN=http://localhost:3000

# Optional: copy the browser project's DSN from Sentry to collect frontend errors; leave empty locally.
PUBLIC_SENTRY_DSN=

# Supabase project URL; copy it from Supabase Project Settings → API for browser authentication.
SUPABASE_URL=https://your-project.supabase.co
# Supabase anon public key; copy it from the same API page for OAuth and email OTP login.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: copy the Measurement ID from a Google Analytics 4 Web data stream for production analytics.
GA_MEASUREMENT_ID=
# Set to 1 when a consent dialog or CMP manages analytics consent; otherwise keep 0.
GA_CONSENT_REQUIRED=0

# Monthly plan display price; keep it aligned with the server billing plan for the pricing card.
PUBLIC_PRICING_MONTHLY_PRICE=4.98
# Yearly plan display price; keep it aligned with the server billing plan for the pricing card.
PUBLIC_PRICING_YEARLY_PRICE=3.98

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "vitest/globals"],
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core-wasm/*": ["../../packages/core/wasm/*"],
      "@treease-web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
